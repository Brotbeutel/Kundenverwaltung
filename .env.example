# Kopieren nach ".env" und mit echten Werten befüllen. Die ".env"-Datei
# NIEMALS ins Git-Repository committen!

FLASK_ENV=entwicklung
SECRET_KEY=bitte-einen-zufaelligen-langen-schluessel-eintragen

# SMTP / Flask-Mail (z.B. Mailtrap.io als Test-Postausgang)
MAIL_SERVER=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=kundenverwaltung@sportless-gmbh.de

# Auf True setzen, solange noch keine echten SMTP-Zugangsdaten vorliegen -
# E-Mails werden dann nur ins Log geschrieben statt versendet.
MAIL_SUPPRESS_SEND=True

# Standardpasswörter für die von init_db.py angelegten Testkonten
ADMIN_STANDARD_PASSWORT=aendere-mich-admin123
MITARBEITER_STANDARD_PASSWORT=aendere-mich-mit123
